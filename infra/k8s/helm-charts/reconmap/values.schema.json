      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "externalHost": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "database": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
