        "api": {
          "type": "string",
          "minLength": 1
        },
        "keycloak": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tls": {
      "type": "boolean"
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "postgresPassword": {
          "type": "string"
        },
        "dbPassword": {
          "type": "string"
        },
        "keycloakDbPassword": {
